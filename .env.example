# Copy to .env and adjust. Never commit real secrets.

# Postgres (transactional booking core)
DATABASE_URL=postgres://flight:flight@localhost:5432/flight_agent

# MongoDB (append-only chat history)
MONGO_URL=mongodb://localhost:27017/flight_agent

# Ollama (local LLM with tool calling)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

# Fastify server
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Append-only error log (relative paths resolve from the repo root)
ERROR_LOG_FILE=logs/agent-errors.log

# Seed determinism: same SEED => identical dataset (dates are relative to the seed day)
SEED=42

# Hold window for hold_seat (minutes)
HOLD_MINUTES=10

# Postgres container credentials (used by docker-compose.yml)
POSTGRES_USER=flight
POSTGRES_PASSWORD=flight
POSTGRES_DB=flight_agent
